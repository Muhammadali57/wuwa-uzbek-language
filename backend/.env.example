# PostgreSQL / Neon connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Exact frontend origin, for example:
# https://YOUR-USERNAME.github.io/YOUR-REPOSITORY
FRONTEND_ORIGIN=https://YOUR-USERNAME.github.io/YOUR-REPOSITORY

# Optional: set a long random value to make the IP hashing salt unique.
RATE_LIMIT_SALT=change-this-to-a-long-random-secret
